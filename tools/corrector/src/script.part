  try { var rawLex = localStorage.getItem("corrector-lexicon"); if (rawLex) { var pl = JSON.parse(rawLex); LEX.words = pl.words || {}; LEX.splits = pl.splits || {}; } } catch (e) { /* no saved list */ }
