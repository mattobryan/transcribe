  /* ---------- recordings: each one keeps its transcript, your edits and (if you allow it) the audio on this device ---------- */
  var LIB = [], mediaFile = null, jsonFile = null;
  function idForReply(reply, chunks) { return reply.transcription_id || (chunks.length + ":" + (chunks[0] && chunks[0].rawRuns[0] ? chunks[0].rawRuns[0].text.slice(0, 30) : "")); }
  function progressOf(rec) {
    try { var raw = localStorage.getItem("corrector2:" + rec.id); if (!raw) return 0; var d = JSON.parse(raw).done || {}, n = 0; for (var k in d) { if (d[k]) n += 1; } return n; } catch (e) { return 0; }
  }
  function libSave() { return idb("set", "recs", LIB); }
  idb("get", "recs").then(function (v) {
    LIB = Array.isArray(v) ? v : [];
    return idb("get", "transcript");                      // the one transcript that earlier versions kept
  }).then(function (old) {
    if (old && old.text) {
      try {
        var rep0 = JSON.parse(old.text), ch0 = buildChunks(rep0), id0 = idForReply(rep0, ch0);
        if (!LIB.some(function (r) { return r.id === id0; })) {
          LIB.push({ id: id0, name: "Interview 1", chunks: ch0.length, added: Date.now(), hasMedia: false });
          idb("set", "rec:" + id0, old.text); libSave();
        }
      } catch (e) { /* not a transcript */ }
    }
    renderLib();
  });
  function renderLib() {
    var box = $("recList"); box.innerHTML = "";
    if (!LIB.length) { var p0 = document.createElement("p"); p0.className = "muted"; p0.textContent = "No recordings yet. Add the first one below."; box.appendChild(p0); return; }
    LIB.forEach(function (rec) {
      var card = document.createElement("div"); card.className = "rec";
      var done = progressOf(rec), name = document.createElement("div"), info = document.createElement("div"), btns = document.createElement("div"), bar = document.createElement("div");
      name.className = "rname"; name.textContent = rec.name;
      info.className = "muted"; info.textContent = done + " of " + (rec.chunks || "?") + " chunks checked" + (rec.hasMedia ? " · audio kept on this device" : " · choose the audio to continue");
      bar.className = "rbar"; var fill = document.createElement("div"); fill.style.width = (rec.chunks ? Math.min(100, 100 * done / rec.chunks) : 0) + "%"; bar.appendChild(fill);
      btns.className = "row";
      if (rec.hasMedia) {
        var go = document.createElement("button"); go.className = "btn small primary"; go.textContent = "Continue"; go.onclick = function () { openSaved(rec, null); }; btns.appendChild(go);
      } else {
        var lab = document.createElement("label"); lab.className = "btn small primary"; lab.textContent = "Choose the audio and continue";
        var inp = document.createElement("input"); inp.type = "file"; inp.accept = "video/*,audio/*,.mp4,.m4a,.mp3,.wav,.3gp,.mkv,.webm"; inp.hidden = true;
        inp.onchange = function () { if (inp.files[0]) openSaved(rec, inp.files[0]); };
        lab.appendChild(inp); btns.appendChild(lab);
      }
      var rm = document.createElement("button"); rm.className = "btn small"; rm.textContent = "Remove from this list"; rm.dataset.armed = "";
      rm.onclick = function () {
        if (!rm.dataset.armed) { rm.dataset.armed = "1"; rm.textContent = "Tap again to remove"; return; }
        LIB = LIB.filter(function (r) { return r.id !== rec.id; }); idb("del", "rec:" + rec.id); idb("del", "media:" + rec.id); libSave(); renderLib();
      };
      btns.appendChild(rm);
      card.appendChild(name); card.appendChild(info); card.appendChild(bar); card.appendChild(btns); box.appendChild(card);
    });
  }
  function openSaved(rec, file) {
    idb("get", "rec:" + rec.id).then(function (text) {
      if (!text) { $("loadMsg").textContent = "The saved transcript for " + rec.name + " is gone from this browser. Add it again below."; return null; }
      return (file ? Promise.resolve(file) : idb("get", "media:" + rec.id)).then(function (media) {
        if (!media) { rec.hasMedia = false; libSave(); renderLib(); $("loadMsg").textContent = "The saved audio is gone. Choose it again."; return; }
        open(JSON.parse(text), rec, media);
      });
    });
  }
  function ready() { $("startBtn").disabled = !(mediaFile && (jsonFile || $("pasteBox").value.trim().length > 20)); }
  $("mediaFile").addEventListener("change", function (e) {
    mediaFile = e.target.files[0] || null;
    $("mediaInfo").textContent = mediaFile ? mediaFile.name + " (" + (mediaFile.size / 1e6).toFixed(1) + " MB)" : "mp4, mp3, m4a, wav, ...";
    $("mediaInfo").className = mediaFile ? "got" : "muted";
    if (mediaFile && !$("recName").value) $("recName").value = mediaFile.name.replace(/\.[^.]+$/, "");
    ready();
  });
  $("jsonFile").addEventListener("change", function (e) {
    jsonFile = e.target.files[0] || null;
    $("jsonInfo").textContent = jsonFile ? jsonFile.name + " (" + (jsonFile.size / 1e6).toFixed(1) + " MB)" : "the .json file (a .txt copy works too)";
    $("jsonInfo").className = jsonFile ? "got" : "muted"; ready();
  });
  $("pasteBox").addEventListener("input", ready);

  $("startBtn").addEventListener("click", function () {
    $("loadMsg").textContent = "";
    function go(text) {
      var reply;
      try { reply = JSON.parse(text); } catch (e) { $("loadMsg").textContent = "That is not a transcript JSON. Copy the whole response from ElevenLabs, from the first { to the last }."; return; }
      if (!reply.words || !reply.words.length) { $("loadMsg").textContent = "This transcript has no word list. Run it again with timestamps_granularity set to word."; return; }
      var ch = buildChunks(reply), id = idForReply(reply, ch);
      var rec = { id: id, name: $("recName").value.trim() || mediaFile.name.replace(/\.[^.]+$/, ""), chunks: ch.length, added: Date.now(), hasMedia: false };
      var keep = $("keepMedia").checked && mediaFile.size < 400e6;
      idb("set", "rec:" + id, text).then(function () { return keep ? idb("set", "media:" + id, mediaFile) : null; }).then(function (ok) {
        rec.hasMedia = !!(keep && ok);
        LIB = LIB.filter(function (r) { return r.id !== id; }).concat([rec]); libSave();
        open(reply, rec, mediaFile);
      });
    }
    if (jsonFile) {
      var reader = new FileReader();
      reader.onerror = function () { $("loadMsg").textContent = "Could not read the transcript file."; };
      reader.onload = function () { go(reader.result); };
      reader.readAsText(jsonFile);
    } else go($("pasteBox").value.trim());
  });

  function migrate(old) {      // edits made before speaker lines existed: label each paragraph if the count matches
    var edits = {};
    for (var k in old.edits || {}) {
      var c = S.chunks[+k]; if (!c || !String(old.edits[k]).trim()) continue;
      var t = old.edits[k], lines = t.split(/\n+/).filter(function (x) { return x.trim(); });
      edits[k] = (!LABEL.test(t) && lines.length === c.runs.length)
        ? lines.map(function (ln, n) { return roleOf(c.runs[n].speaker) + ": " + ln.trim(); }).join("\n") : t;
    }
    return edits;
  }

  function open(reply, rec, media) {
    S.rec = rec; S.chunks = buildChunks(reply); S.shown = false; S.idx = 0; proseNow = -1;
    S.speakers = S.chunks.speakerOrder || [];
    var id = idForReply(reply, S.chunks);
    S.key = "corrector2:" + id;
    S.interviewer = S.speakers[0] || null;
    var saved = store("get");
    if (saved) { S.edits = saved.edits || {}; S.done = saved.done || {}; S.interviewer = saved.interviewer || S.interviewer; S.reviewWords = saved.reviewWords || REVIEW_DEFAULT.slice(); S.autoSwitch = saved.autoSwitch !== false; }
    else {
      var old = store("get", null, "corrector:" + id);
      S.edits = old ? migrate(old) : {}; S.done = old ? (old.done || {}) : {}; S.reviewWords = REVIEW_DEFAULT.slice();
    }
    persist();
    if (S.mediaUrl) URL.revokeObjectURL(S.mediaUrl);
    S.mediaUrl = URL.createObjectURL(media);
    video.src = S.mediaUrl;
    $("xName").value = rec.name;
    $("setup").hidden = true; $("work").hidden = false; $("progress").hidden = false; $("tools").hidden = false; $("panels").hidden = false;
    buildProse(); buildSpeakers(); showReview(); scheduleRail(); $("autoSwitch").checked = S.autoSwitch;
    var first = 0;
    for (var i = 0; i < S.chunks.length; i++) { if (!S.done[i]) { first = i; break; } }
    select(first, false);
    updateProgress();
  }
  function showSetup() {                       // back to the list of recordings
    stash(); video.pause();
    $("work").hidden = true; $("panels").hidden = true; $("progress").hidden = true; $("tools").hidden = true; $("setup").hidden = false;
    renderLib();
  }
  $("tHome").onclick = showSetup;

  /* ---------- ElevenLabs settings box on the first screen ---------- */
  var KEYTERMS_DEFAULT = "postnatal\nantenatal\nward\nhandover\nlocum\nKRCHN\nclinician\nCS mothers\nSVD\ntheatre\nNHIF\nSHA\nKenyatta";
  try { $("elKeyterms").value = localStorage.getItem("corrector-keyterms") || KEYTERMS_DEFAULT; } catch (e) { $("elKeyterms").value = KEYTERMS_DEFAULT; }
  $("elKeyterms").addEventListener("input", function () { try { localStorage.setItem("corrector-keyterms", $("elKeyterms").value); } catch (e) { /* not saved */ } });
  $("elCopy").onclick = function () {
    var t = $("elKeyterms").value.split("\n").map(function (x) { return x.trim(); }).filter(Boolean).join("\n"), done = function () { toast("Copied the key terms"); };
    try { navigator.clipboard.writeText(t).then(done, function () { $("elKeyterms").select(); }); } catch (e) { $("elKeyterms").select(); }
  };

  /* ---------- the script: the whole interview as one flowing text, like oTranscribe ---------- */
  var proseTimer = 0, proseNow = -1, userScrollUntil = 0;
  function chunkAt(t) {
    var lo = 0, hi = S.chunks.length - 1, ans = 0;
    while (lo <= hi) { var mid = (lo + hi) >> 1; if (S.chunks[mid].start <= t + 0.05) { ans = mid; lo = mid + 1; } else hi = mid - 1; }
    return ans;
  }
  function segClass(i) { return "seg" + (S.done[i] ? " done" : "") + (isFlagged(i) && !S.done[i] ? " flagged" : "") + (hasEdit(i) && !S.done[i] ? " edited" : "") + (i === S.idx ? " cur" : "") + (i === proseNow ? " now" : ""); }
  function buildProse() {
    var turnsArr = [], cur = null, pane = $("prosePane"), top = pane.scrollTop;
    scheduleRail();
    S.chunks.forEach(function (c, i) {
      parseLines(textOf(i)).forEach(function (l) {
        var span = '<span class="' + segClass(i) + '" data-i="' + i + '">' + bodyHTML(l.text) + "</span>";
        if (cur && cur.label === l.label) cur.parts.push(span); else { cur = { label: l.label, ts: c.start, parts: [span] }; turnsArr.push(cur); }
      });
    });
    $("prose").innerHTML = turnsArr.map(function (t) {
      return '<p class="turn ' + (t.label.charAt(0) === "I" ? "i" : "r") + '"><span class="ts" role="button">' + fmt(t.ts) + '</span> <span class="lab">' + t.label + ":</span> " + t.parts.join(" ") + "</p>";
    }).join("");
    pane.scrollTop = top;
  }
  function scheduleProse() { clearTimeout(proseTimer); proseTimer = setTimeout(buildProse, 250); }
  function paintItem(i) {          // colours only; the text itself is redrawn by scheduleProse()
    scheduleRail();
    Array.prototype.forEach.call($("prose").querySelectorAll('.seg[data-i="' + i + '"]'), function (el) { el.className = segClass(i); });
  }
  function scrollProseTo(el, smooth, always) {      // keep a section in view without moving the page or the editor
    var pane = $("prosePane"), pr = pane.getBoundingClientRect(), r = el.getBoundingClientRect();
    if (!always && r.top >= pr.top + 8 && r.bottom <= pr.bottom - 8) return;
    pane.scrollTo({ top: pane.scrollTop + (r.top - pr.top) - pane.clientHeight / 3, behavior: smooth ? "smooth" : "auto" });
  }
  function markNow(force) {           // the section being heard
    if (!railDrag) placeThumb(video.currentTime);
    var i = chunkAt(video.currentTime);
    if (i === proseNow && !force) return;
    var old = proseNow; proseNow = i;
    if (old >= 0) paintItem(old);
    paintItem(i);
    var first = $("prose").querySelector('.seg[data-i="' + i + '"]'), j = i;
    while (!first && j > 0) { j -= 1; first = $("prose").querySelector('.seg[data-i="' + j + '"]'); }
    if (first && (force || ($("follow").checked && Date.now() > userScrollUntil))) scrollProseTo(first, !force);
    $("nowInfo").textContent = "Playing chunk " + (i + 1) + " · " + fmt(video.currentTime);
  }
  ["wheel", "touchstart", "touchmove"].forEach(function (ev) {      // reading ahead: do not pull the page back to the audio
    $("prosePane").addEventListener(ev, function () { userScrollUntil = Date.now() + 8000; }, { passive: true });
  });
  $("prosePane").addEventListener("click", function (e) {
    var ts = e.target.closest(".ts"), el = ts ? ts.parentNode.querySelector(".seg") : e.target.closest(".seg");
    if (!el) return;
    userScrollUntil = Date.now() + 8000;
    select(+el.dataset.i, true); S.oneShot = null;
  });
  // buttons and the script never take focus from the editor, so the on-screen keyboard stays up
  document.addEventListener("mousedown", function (e) { if (e.target.closest("button, #prosePane")) e.preventDefault(); });

  function updateProgress() {
    var n = 0; for (var k in S.done) { if (S.done[k]) n += 1; }
    $("progLabel").textContent = n + " of " + S.chunks.length + " chunks checked";
    $("progFill").style.width = (S.chunks.length ? (100 * n / S.chunks.length) : 0) + "%";
  }

  /* ---------- editing ---------- */
  function showPreview() { $("previewBody").innerHTML = previewHTML($("text").value); }
  function stash() {          // keep what is typed, without marking the chunk as checked
    if (!S.chunks.length || !S.shown) return;
    var v = $("text").value, i = S.idx;
    if (v !== textOf(i)) {
      if (v === origText(i)) delete S.edits[i]; else S.edits[i] = v;
      persist(); paintItem(i); scheduleProse();
    }
  }
  function who(i) {
    var l = parseLines(textOf(i)).map(function (x) { return x.label; });
    var hasI = l.some(function (x) { return x.charAt(0) === "I"; }), hasR = l.some(function (x) { return x.charAt(0) === "R"; });
    return hasI && hasR ? "Interviewer + respondent" : hasI ? "Interviewer" : "Respondent";
  }
  function select(i, play, keepAudio) {
    if (!S.chunks.length) return;
    stash(); S.dirty = false;
    S.shown = true;
    i = Math.max(0, Math.min(S.chunks.length - 1, i));
    var prev = S.idx; S.idx = i; paintItem(prev); paintItem(i);
    var c = S.chunks[i];
    $("cTitle").textContent = "Chunk " + (i + 1) + " of " + S.chunks.length;
    $("cTime").textContent = fmt(c.start) + " – " + fmt(c.end);
    $("cSpk").textContent = who(i);
    var st = $("cState");
    if (S.done[i]) { st.textContent = "checked"; st.className = "pill done"; }
    else if (isFlagged(i)) { st.textContent = "check: " + flagsOf(i).join("; "); st.className = "pill flag"; }
    else { st.textContent = "not checked yet"; st.className = "pill"; }
    var ta = $("text");
    ta.value = textOf(i); showPreview();
    $("origWrap").hidden = !hasEdit(i); $("original").textContent = origText(i).replace(/\n/g, "  ");
    var el = $("prose").querySelector('.seg[data-i="' + i + '"]'); if (el) scrollProseTo(el, false);
    if (!keepAudio) {
      video.pause();
      try { video.currentTime = c.start; } catch (e) { /* metadata not ready yet */ }
      if (play) playNow();
    }
    ta.focus({ preventScroll: true }); ta.setSelectionRange(ta.value.length, ta.value.length);     // ready to type straight away
  }
  function beginEdit() { S.dirty = true; if (!video.paused) video.pause(); }      // typing stops the audio; saving starts it again
  function saveAnd(mode) {
    stash(); S.done[S.idx] = true; S.dirty = false; persist(); paintItem(S.idx); updateProgress();
    var next = Math.min(S.idx + 1, S.chunks.length - 1);
    select(next, true);
    S.oneShot = mode === "chunk" ? next : null;       // "next chunk": play it and stop. "continue": keep going through the whole script
  }
  function saveNext() { saveAnd("chunk"); }
  function nextFlagged() {
    for (var step = 1; step <= S.chunks.length; step++) {
      var j = (S.idx + step) % S.chunks.length;
      if (!S.done[j] && isFlagged(j)) { select(j, true); return; }
    }
    toast("No unchecked flagged chunks left");
  }
  function editPlaying() { video.pause(); select(chunkAt(video.currentTime), false, true); }      // the section being heard goes into the editor
  function switchLine() {         // I: <-> R: on the line with the cursor
    var ta = $("text"), v = ta.value, pos = ta.selectionStart;
    var a = v.lastIndexOf("\n", pos - 1) + 1, b = v.indexOf("\n", pos); if (b < 0) b = v.length;
    var line = v.slice(a, b), m = LABEL.exec(line), body = line.replace(LABEL, "");
    var next = m ? (m[1].charAt(0) === "I" ? "R" : "I") + m[1].slice(1) + ": " : "I: ";
    ta.value = v.slice(0, a) + next + body + v.slice(b);
    var p = a + next.length + Math.max(0, pos - a - (m ? m[0].length : 0));
    ta.setSelectionRange(p, p); beginEdit(); showPreview(); stash(); $("cSpk").textContent = who(S.idx);
  }
  $("text").addEventListener("input", function (e) {
    var ta = e.target; beginEdit();
    if (e.inputType === "insertText" && e.data && /^\p{Ll}$/u.test(e.data)) {       // a new sentence or a new line starts with a capital
      var v = ta.value, pos = ta.selectionStart, a = v.lastIndexOf("\n", pos - 2) + 1, before = v.slice(a, pos - 1);
      var m = LABEL.exec(before + "x");
      if ((m && before.length === m[0].length) || /(^|[.?!]["')”’]?\s)$/.test(before) || before === "") {
        ta.setRangeText(e.data.toUpperCase(), pos - 1, pos, "end");
      }
    }
    showPreview();
  });
  $("text").addEventListener("keydown", function (e) {        // Enter: the new line belongs to the other speaker
    if (e.key !== "Enter" || e.ctrlKey || e.metaKey || e.altKey || e.shiftKey || !S.autoSwitch) return;
    var ta = e.target, v = ta.value, pos = ta.selectionStart;
    var a = v.lastIndexOf("\n", pos - 1) + 1, lineText = v.slice(a).split("\n")[0], m = LABEL.exec(lineText);
    if (!m || pos < a + m[0].length) return;                  // a line without a label, or the cursor is inside the label: plain new line
    e.preventDefault();
    ta.setRangeText("\n" + (m[1].charAt(0) === "I" ? "R" : "I") + ": ", ta.selectionStart, ta.selectionEnd, "end");
    beginEdit(); showPreview(); $("cSpk").textContent = who(S.idx);
  });
  $("autoSwitch").addEventListener("change", function () { S.autoSwitch = $("autoSwitch").checked; persist(); });

  /* ---------- formatting the selection: bold, italic, not Swahili ---------- */
  var MARKS = { bold: "**", italic: "_", plain: "~" };
  function lineSegments(v, a, b) {           // the parts of the selection, line by line, never touching the I: / R: label
    var segs = [], pos = a;
    for (;;) {
      var ls = v.lastIndexOf("\n", pos - 1) + 1, le = v.indexOf("\n", pos); if (le < 0) le = v.length;
      var s0 = Math.max(a, ls), e0 = Math.min(b, le), m = LABEL.exec(v.slice(ls, le));
      if (m && s0 < ls + m[0].length) s0 = ls + m[0].length;
      while (s0 < e0 && /\s/.test(v.charAt(s0))) s0++;
      while (e0 > s0 && /\s/.test(v.charAt(e0 - 1))) e0--;
      if (e0 > s0) segs.push([s0, e0]);
      if (le >= b) break;
      pos = le + 1;
    }
    return segs;
  }
  function wordAt(v, pos) {
    var re = /[\p{L}\p{N}'’-]+/gu, m;
    while ((m = re.exec(v))) { if (pos >= m.index && pos <= m.index + m[0].length) return [m.index, m.index + m[0].length]; }
    return null;
  }
  function removeKind(seg, kind) {
    return kind === "bold" ? seg.replace(/\*\*/g, "") : kind === "italic" ? seg.replace(/_(.+?)_/g, "$1") : seg.replace(/~/g, "");
  }
  function formatSel(kind) {
    var ta = $("text"), v = ta.value, a = ta.selectionStart, b = ta.selectionEnd;
    if (a === b) { var w = wordAt(v, a); if (!w) { toast("Select some text first"); return; } a = w[0]; b = w[1]; }   // no selection: the word under the cursor
    var segs = lineSegments(v, a, b);
    if (!segs.length) { toast("Select some text first"); return; }
    var info = [];                                  // per piece: where its text starts and ends afterwards, and how much the length changed
    for (var n = segs.length - 1; n >= 0; n--) {
      var s0 = segs[n][0], e0 = segs[n][1], seg = v.slice(s0, e0), rec;
      if (kind === "clear") {
        var grew = true;
        while (grew) {                       // take in marks that sit right outside the selection
          grew = false;
          ["**", "_", "~"].forEach(function (mk2) { if (v.slice(s0 - mk2.length, s0) === mk2 && v.slice(e0, e0 + mk2.length) === mk2) { s0 -= mk2.length; e0 += mk2.length; grew = true; } });
        }
        var cleaned = stripMarks(v.slice(s0, e0));
        rec = { start: s0, end: s0 + cleaned.length, delta: cleaned.length - (e0 - s0) };
        v = v.slice(0, s0) + cleaned + v.slice(e0);
      } else {
        var mk = MARKS[kind];
        if (v.slice(s0 - mk.length, s0) === mk && v.slice(e0, e0 + mk.length) === mk) {            // already marked: take the mark off
          rec = { start: s0 - mk.length, end: s0 - mk.length + seg.length, delta: -2 * mk.length };
          v = v.slice(0, s0 - mk.length) + seg + v.slice(e0 + mk.length);
        } else {
          var inner = removeKind(seg, kind);
          rec = { start: s0 + mk.length, end: s0 + mk.length + inner.length, delta: inner.length + 2 * mk.length - seg.length };
          v = v.slice(0, s0) + mk + inner + mk + v.slice(e0);
        }
      }
      info[n] = rec;
    }
    var shift = 0; for (var q = 0; q < info.length - 1; q++) shift += info[q].delta;
    ta.value = v; ta.focus({ preventScroll: true });
    ta.setSelectionRange(info[0].start, info[info.length - 1].end + shift);          // the text stays selected, so B then I can be tapped one after the other
    beginEdit(); showPreview(); stash();
  }
  $("mBold").onclick = function () { formatSel("bold"); };
  $("mItalic").onclick = function () { formatSel("italic"); };
  $("mPlain").onclick = function () { formatSel("plain"); };
  $("mClear").onclick = function () { formatSel("clear"); };

  /* ---------- playback (the recording is heard, not shown) ---------- */
  function playNow() { var p = video.play(); if (p && p.catch) p.catch(function () { /* needs a tap first */ }); }
  function togglePlay() {
    S.oneShot = null;
    if (video.paused) { var c = S.chunks[S.idx]; if (holdsToChunk() && c && (video.currentTime >= c.end - 0.05 || video.currentTime < c.start - 0.5)) video.currentTime = c.start; playNow(); }
    else video.pause();
  }
  function holdsToChunk() { return $("stopEnd").checked || S.dirty || S.oneShot === S.idx; }       // while you edit, the audio stays inside the chunk
  function seekBy(d) {
    var c = S.chunks[S.idx], t = video.currentTime + d;
    if (holdsToChunk() && c) t = Math.max(c.start, Math.min(c.end - 0.1, t));
    video.currentTime = Math.max(0, t);
  }
  function setSpeed(d) {
    var r = Math.round((video.playbackRate + d) * 100) / 100;
    video.playbackRate = Math.max(0.5, Math.min(2, r));
    $("speed").textContent = video.playbackRate.toFixed(2) + "×";
  }
  var stopTimer = 0;
  function checkStop() {          // checked every 60 ms while playing, so the audio stops at the end of the chunk, not a moment after
    var c = S.chunks[S.idx];
    if (c && holdsToChunk() && !video.paused && video.currentTime >= c.end) { video.pause(); video.currentTime = c.end; S.oneShot = null; }
  }
  video.addEventListener("timeupdate", function () { markNow(false); checkStop(); });
  video.addEventListener("play", function () { $("bPlay").textContent = "Pause"; clearInterval(stopTimer); stopTimer = setInterval(checkStop, 60); });
  video.addEventListener("pause", function () { $("bPlay").textContent = "Play"; clearInterval(stopTimer); });
  video.addEventListener("loadedmetadata", function () { var c = S.chunks[S.idx]; if (c) video.currentTime = c.start; });
  video.addEventListener("error", function () { toast("This recording could not be played here. Try the audio file instead."); });

  $("bPlay").onclick = togglePlay; $("bBack").onclick = function () { seekBy(-3); }; $("bFwd").onclick = function () { seekBy(3); };
  $("bSlow").onclick = function () { setSpeed(-0.25); }; $("bFast").onclick = function () { setSpeed(0.25); };
  $("bPrev").onclick = function () { select(S.idx - 1, true); }; $("bSave").onclick = saveNext; $("bSaveGo").onclick = function () { saveAnd("continue"); }; $("bFlag").onclick = nextFlagged;
  $("bHear").onclick = editPlaying; $("bNow").onclick = function () { userScrollUntil = 0; markNow(true); };
  $("bLine").onclick = function () { $("text").focus(); switchLine(); };
  $("bReset").onclick = function () { $("text").value = origText(S.idx); stash(); S.dirty = false; select(S.idx, false, true); };
  $("text").addEventListener("blur", stash);

  document.addEventListener("keydown", function (e) {
    if ($("work").hidden) return;
    var k = e.key;
    if (k === "Escape") { e.preventDefault(); togglePlay(); }
    else if (k === "F1") { e.preventDefault(); seekBy(-3); }
    else if (k === "F2") { e.preventDefault(); seekBy(3); }
    else if (k === "F3") { e.preventDefault(); setSpeed(-0.25); }
    else if (k === "F4") { e.preventDefault(); setSpeed(0.25); }
    else if ((e.ctrlKey || e.metaKey) && k === "Enter") { e.preventDefault(); saveAnd(e.shiftKey ? "continue" : "chunk"); }
    else if (e.altKey && k === "ArrowDown") { e.preventDefault(); select(S.idx + 1, true); }
    else if (e.altKey && k === "ArrowUp") { e.preventDefault(); select(S.idx - 1, true); }
    else if (e.altKey && (k === "n" || k === "N")) { e.preventDefault(); nextFlagged(); }
    else if (e.altKey && (k === "e" || k === "E")) { e.preventDefault(); editPlaying(); }
    else if (e.altKey && (k === "i" || k === "I")) { e.preventDefault(); $("text").focus(); switchLine(); }
    else if ((e.ctrlKey || e.metaKey) && (k === "b" || k === "B") && document.activeElement === $("text")) { e.preventDefault(); formatSel("bold"); }
    else if ((e.ctrlKey || e.metaKey) && (k === "i" || k === "I") && document.activeElement === $("text")) { e.preventDefault(); formatSel("italic"); }
    else if ((e.ctrlKey || e.metaKey) && (k === "s" || k === "S")) { e.preventDefault(); stash(); toast("Saved in this browser"); }
  });

  /* ---------- the rail ---------- */
  var railDrag = null, railRaf = 0;
  function totalTime() {
    var d = video.duration, last = S.chunks.length ? S.chunks[S.chunks.length - 1].end : 0;
    return (isFinite(d) && d > 0) ? Math.max(d, 1) : Math.max(last, 1);
  }
  function drawRail() {
    railRaf = 0;
    var cv = $("railCanvas"), rail = $("rail"), w = rail.clientWidth, h = rail.clientHeight;
    if (!w || !h || !S.chunks.length) return;
    var dpr = window.devicePixelRatio || 1;
    cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr);
    var g = cv.getContext("2d"); g.scale(dpr, dpr);
    var cs = getComputedStyle(document.documentElement), dur = totalTime();
    var ok = cs.getPropertyValue("--ok").trim(), flag = cs.getPropertyValue("--flag").trim(), warn = cs.getPropertyValue("--warn").trim(), accent = cs.getPropertyValue("--accent").trim();
    S.chunks.forEach(function (c, i) {
      var y = c.start / dur * h, bh = Math.max(2, (c.end - c.start) / dur * h);
      if (S.done[i]) { g.globalAlpha = 0.5; g.fillStyle = ok; g.fillRect(5, y, w - 10, bh); }
      else if (isFlagged(i)) { g.globalAlpha = 1; g.fillStyle = flag; g.fillRect(2, y, w - 4, Math.max(3, bh)); }
      else if (hasEdit(i)) { g.globalAlpha = 0.8; g.fillStyle = warn; g.fillRect(8, y, w - 16, bh); }
    });
    g.globalAlpha = 1;
    var cur = S.chunks[S.idx]; if (cur) { g.fillStyle = accent; g.fillRect(0, cur.start / dur * h, w, 2); }       // the chunk in the editor
  }
  function scheduleRail() { if (!railRaf) railRaf = requestAnimationFrame(drawRail); }
  function placeThumb(t) {
    var rail = $("rail"), h = rail.clientHeight, f = Math.max(0, Math.min(1, t / totalTime()));
    $("railThumb").style.transform = "translateY(" + (f * Math.max(0, h - 14)) + "px)";
    rail.setAttribute("aria-valuenow", String(Math.round(t))); rail.setAttribute("aria-valuemax", String(Math.round(totalTime())));
  }
  function railTime(e) {
    var r = $("rail").getBoundingClientRect(), f = (e.clientY - r.top - 7) / Math.max(1, r.height - 14);
    return Math.max(0, Math.min(1, f)) * totalTime();
  }
  function railMove(e) {                   // while dragging: the thumb, the time and the script move, the audio waits until you let go
    var t = railTime(e); railDrag.t = t; placeThumb(t);
    var tip = $("railTip"); tip.hidden = false; tip.textContent = fmt(t);
    tip.style.top = Math.max(0, Math.min($("rail").clientHeight - 24, (t / totalTime()) * ($("rail").clientHeight - 14) - 4)) + "px";
    var el = $("prose").querySelector('.seg[data-i="' + chunkAt(t) + '"]'); if (el) scrollProseTo(el, false, true);
  }
  function railEnd() {
    if (!railDrag) return;
    var t = railDrag.t; railDrag = null; $("railTip").hidden = true;
    video.currentTime = t; proseNow = -1; markNow(true);
  }
  $("rail").addEventListener("pointerdown", function (e) { e.preventDefault(); $("rail").setPointerCapture(e.pointerId); railDrag = { t: 0 }; userScrollUntil = Date.now() + 8000; railMove(e); });
  $("rail").addEventListener("pointermove", function (e) { if (railDrag) railMove(e); });
  $("rail").addEventListener("pointerup", railEnd);
  $("rail").addEventListener("pointercancel", railEnd);
  $("rail").addEventListener("keydown", function (e) {
    var d = e.key === "ArrowUp" ? -10 : e.key === "ArrowDown" ? 10 : e.key === "PageUp" ? -60 : e.key === "PageDown" ? 60 : 0;
    if (d) { e.preventDefault(); video.currentTime = Math.max(0, video.currentTime + d); }
  });
  window.addEventListener("resize", function () { scheduleRail(); placeThumb(video.currentTime); });
  video.addEventListener("loadedmetadata", function () { scheduleRail(); placeThumb(video.currentTime); });
  video.addEventListener("seeked", function () { if (!railDrag) placeThumb(video.currentTime); });

  /* ---------- colours: warm, light, night ---------- */
  var SKINS = ["warm", "light", "night"], SKIN_NAME = { warm: "Warm theme", light: "Light theme", night: "Night theme" };
  function applySkin(k) { document.documentElement.setAttribute("data-skin", k); scheduleRail(); $("tTheme").textContent = SKIN_NAME[k]; try { localStorage.setItem("corrector-skin", k); } catch (e) { /* not saved */ } }
  var skin = "warm"; try { skin = localStorage.getItem("corrector-skin") || "warm"; } catch (e) { /* default */ }
  applySkin(SKINS.indexOf(skin) >= 0 ? skin : "warm");
  $("tTheme").onclick = function () { applySkin(SKINS[(SKINS.indexOf(document.documentElement.getAttribute("data-skin")) + 1) % SKINS.length]); };

  /* ---------- tool panels ---------- */
  var PANELS = { tLang: "pLang", tFix: "pFix", tRev: "pRev", tSpk: "pSpk", tOut: "pOut" };
  Object.keys(PANELS).forEach(function (btn) {
    $(btn).addEventListener("click", function () {
      var show = $(PANELS[btn]).hidden;
      Object.keys(PANELS).forEach(function (b) { $(PANELS[b]).hidden = true; $(b).setAttribute("aria-pressed", "false"); });
      if (show) { $(PANELS[btn]).hidden = false; $(btn).setAttribute("aria-pressed", "true"); if (btn === "tOut") showRich(); if (btn === "tLang") renderLang(); }
    });
  });

  /* ---------- fix everywhere ---------- */
  function escRe(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"); }
  function makeRegex() {
    var find = $("fFind").value;
    if (!find) return null;
    var src = $("fRegex").checked ? find : escRe(find);
    if (!$("fRegex").checked && $("fWhole").checked) src = "(?<![\\p{L}\\p{N}'’])" + src + "(?![\\p{L}\\p{N}'’])";
    try { return new RegExp(src, "gu" + ($("fCase").checked ? "" : "i")); } catch (e) { $("fMsg").textContent = "That pattern is not valid."; return null; }
  }
  function previewReplace() {
    var re = makeRegex(); if (!re) return null;
    var chunks = 0, hits = 0;
    for (var i = 0; i < S.chunks.length; i++) { var m = textOf(i).match(re); if (m) { chunks += 1; hits += m.length; } }
    $("fMsg").textContent = hits + " match" + (hits === 1 ? "" : "es") + " in " + chunks + " chunk" + (chunks === 1 ? "" : "s");
    return re;
  }
  function tidy(t) {          // after a replacement: no double spaces, no lines that only hold a label
    return t.split("\n").map(function (l) { return l.replace(/[ \t]{2,}/g, " ").trim(); })
      .filter(function (l) { return l && !/^[IR]\d*:$/.test(l); }).join("\n");
  }
  $("fPreview").onclick = previewReplace;
  $("fApply").onclick = function () {
    stash();
    var re = previewReplace(); if (!re) return;
    var repl = $("fRepl").value, before = {}, n = 0;
    for (var i = 0; i < S.chunks.length; i++) {
      var t = textOf(i), u = tidy(t.replace(re, repl));
      if (u !== t) { before[i] = hasEdit(i) ? S.edits[i] : null; if (u === origText(i)) delete S.edits[i]; else S.edits[i] = u; n += 1; paintItem(i); }
    }
    S.undo = before; $("fUndo").disabled = !n; persist(); scheduleProse();
    $("text").value = textOf(S.idx); showPreview();
    $("fMsg").textContent = "Replaced in " + n + " chunk" + (n === 1 ? "" : "s");
  };
  $("fUndo").onclick = function () {
    if (!S.undo) return;
    for (var k in S.undo) { if (S.undo[k] === null) delete S.edits[k]; else S.edits[k] = S.undo[k]; paintItem(+k); }
    S.undo = null; $("fUndo").disabled = true; persist(); scheduleProse(); $("text").value = textOf(S.idx); showPreview();
    $("fMsg").textContent = "Undone";
  };
  $("fBack").onclick = function () {
    $("fFind").value = "\\b(?:Mm-hmm|Mhm|Uh-huh|Mm)\\b[.,]?[ \\t]*"; $("fRepl").value = ""; $("fRegex").checked = true; $("fCase").checked = false;
    previewReplace();
  };

  /* ---------- words to review ---------- */
  function showReview() { $("rList").textContent = S.reviewWords.length ? S.reviewWords.join(", ") : "none"; }
  function afterReviewChange() { persist(); showReview(); scheduleProse(); select(S.idx, false, true); }
  $("rAdd").onclick = function () {
    var w = $("rWord").value.trim().toLowerCase().replace(/[^\p{L}\p{N}'\-]/gu, "");
    if (!w) return;
    if (S.reviewWords.indexOf(w) < 0) S.reviewWords.push(w);
    $("rWord").value = ""; afterReviewChange();
  };
  $("rClear").onclick = function () { S.reviewWords = []; afterReviewChange(); };
  $("rDefault").onclick = function () { S.reviewWords = REVIEW_DEFAULT.slice(); afterReviewChange(); };

  /* ---------- who is the interviewer ---------- */
  function buildSpeakers() {
    var sel = $("spkSel"); sel.innerHTML = "";
    S.speakers.forEach(function (name) {
      var o = document.createElement("option"); o.value = name; o.textContent = name; if (name === S.interviewer) o.selected = true; sel.appendChild(o);
    });
    sel.onchange = function () {
      stash();
      var was = S.interviewer; S.interviewer = sel.value;
      if (S.speakers.length === 2 && was !== S.interviewer) {          // two speakers: flip the labels you already edited
        for (var k in S.edits) S.edits[k] = S.edits[k].split("\n").map(function (l) { var m = LABEL.exec(l); return m ? (m[1].charAt(0) === "I" ? "R" : "I") + m[1].slice(1) + ": " + l.replace(LABEL, "") : l; }).join("\n");
      }
      persist();
      scheduleProse(); $("text").value = textOf(S.idx); showPreview();
      $("spkMsg").textContent = "Done. " + S.interviewer + " is the interviewer (I:).";
    };
  }

  /* ---------- export ---------- */
  function turns() {          // lines of the same speaker run together, across chunk boundaries
    stash();
    var out = [];
    S.chunks.forEach(function (c, i) {
      parseLines(textOf(i)).forEach(function (l, n) {
        var last = out[out.length - 1];
        if (last && last.label === l.label && !(l.explicit && n === 0 && false)) last.text = joinText(last.text, l.text);
        else out.push({ label: l.label, text: l.text, start: c.start });
      });
    });
    return out;
  }
  function withTime() { return $("xT1").checked; }
  function stamp(t) { return withTime() ? "[" + fmt(t.start) + "] " : ""; }
  function richHTML() { return turns().map(function (t) { var b = bodyHTML(t.text); return "<p>" + stamp(t) + (t.label.charAt(0) === "I" ? "<b>" + t.label + ": " + b + "</b>" : t.label + ": " + b) + "</p>"; }).join(""); }
  function plainText() { return turns().map(function (t) { return stamp(t) + t.label + ": " + stripMarks(t.text); }).join("\n\n") + "\n"; }
  function srtTime(t) { var ms = Math.round(t * 1000), p = function (n, w) { return ("000" + n).slice(-w); }; return p(Math.floor(ms / 3600000), 2) + ":" + p(Math.floor(ms / 60000) % 60, 2) + ":" + p(Math.floor(ms / 1000) % 60, 2) + "," + p(ms % 1000, 3); }
  function render(kind) {
    stash();
    if (kind === "txt") return plainText();
    if (kind === "json") return JSON.stringify(S.chunks.map(function (c, i) {
      return { start: c.start, end: c.end, checked: !!S.done[i], lines: parseLines(textOf(i)).map(function (l) { return { speaker: l.label, text: stripMarks(l.text) }; }) };
    }), null, 1);
    return S.chunks.map(function (c, i) {
      return (i + 1) + "\n" + srtTime(c.start) + " --> " + srtTime(c.end) + "\n" + parseLines(textOf(i)).map(function (l) { return l.label + ": " + stripMarks(l.text); }).join(" ") + "\n";
    }).join("\n") + "\n";
  }
  function showRich() { $("out").hidden = true; $("richOut").hidden = false; $("richOut").innerHTML = richHTML(); }
  $("xT0").addEventListener("change", showRich); $("xT1").addEventListener("change", showRich);


  /* ---------- the Word file: header with the name, title, I:/R: key, the script, "Page x of y" at the bottom ---------- */
  function fmtSegs(text, b, i, noAuto) {        // runs with their own bold and italic: your marks first, Swahili italics for the rest
    var re = new RegExp(MARK_SRC, "gu"), out = [], last = 0, m;
    function plain(t) {
      if (!t) return;
      if (noAuto) { out.push({ t: t, b: b, i: i }); return; }
      tokenize(t).forEach(function (it) {
        if (it.gap) out.push({ t: it.gap, b: b, i: i });
        it.segs.forEach(function (sg) { out.push({ t: sg[0], b: b, i: i || sg[1] === "sw" }); });
      });
    }
    while ((m = re.exec(text))) {
      plain(text.slice(last, m.index));
      if (m[1] !== undefined) out = out.concat(fmtSegs(m[1], true, i, noAuto));
      else if (m[2] !== undefined) out = out.concat(fmtSegs(m[2], b, true, true));
      else out = out.concat(fmtSegs(m[3], b, i, true));
      last = m.index + m[0].length;
    }
    plain(text.slice(last));
    var merged = [];
    out.forEach(function (sg) { var p = merged[merged.length - 1]; if (p && p.b === sg.b && p.i === sg.i) p.t += sg.t; else merged.push({ t: sg.t, b: sg.b, i: sg.i }); });
    return merged;
  }
  function xe(t) { return String(t).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g, ""); }
  var RPR_BASE = '<w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman"/>', RPR_SIZE = '<w:sz w:val="24"/><w:szCs w:val="24"/>';   // Times New Roman 12 pt everywhere
  function runXml(sg, caps) {
    return "<w:r><w:rPr>" + RPR_BASE + (sg.b ? "<w:b/>" : "") + (sg.i ? "<w:i/>" : "") + (caps ? "<w:caps/>" : "") + RPR_SIZE + '</w:rPr><w:t xml:space="preserve">' + xe(sg.t) + "</w:t></w:r>";
  }
  function fieldXml(code) { return '<w:fldSimple w:instr=" ' + code + ' "><w:r><w:rPr>' + RPR_BASE + RPR_SIZE + "</w:rPr><w:t>1</w:t></w:r></w:fldSimple>"; }
  function paraXml(runs, jc) {              // single line spacing and one blank line (12 pt) after every paragraph
    return '<w:p><w:pPr><w:spacing w:after="240" w:line="240" w:lineRule="auto"/>' + (jc ? '<w:jc w:val="' + jc + '"/>' : "") + "</w:pPr>" + runs + "</w:p>";
  }
  function buildDocx(name, timed) {
    var NS = 'xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"';
    var head = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>';
    var body = "";
    body += paraXml(runXml({ t: name.toUpperCase(), b: true, i: false }, true), "center");
    body += paraXml(runXml({ t: "I: Interviewer", b: true, i: false }));
    body += paraXml(runXml({ t: "R: Respondent", b: false, i: false }));
    turns().forEach(function (t) {
      var isI = t.label.charAt(0) === "I", segs = fmtSegs(t.text, isI, false, false);
      var lead = (timed ? "[" + fmt(t.start) + "] " : "") + t.label + ": ";
      body += paraXml(runXml({ t: lead, b: isI, i: false }) + segs.map(function (sg) { return runXml(sg); }).join(""));
    });
    body += '<w:sectPr><w:headerReference w:type="default" r:id="rId2"/><w:footerReference w:type="default" r:id="rId3"/><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="708" w:footer="708" w:gutter="0"/></w:sectPr>';
    var files = {
      "[Content_Types].xml": head + '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/><Override PartName="/word/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml"/><Override PartName="/word/header1.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.header+xml"/><Override PartName="/word/footer1.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.footer+xml"/></Types>',
      "_rels/.rels": head + '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/></Relationships>',
      "word/_rels/document.xml.rels": head + '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/><Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/header" Target="header1.xml"/><Relationship Id="rId3" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/footer" Target="footer1.xml"/></Relationships>',
      "word/styles.xml": head + '<w:styles ' + NS + '><w:docDefaults><w:rPrDefault><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:val="en-GB"/></w:rPr></w:rPrDefault><w:pPrDefault><w:pPr><w:spacing w:after="240" w:line="240" w:lineRule="auto"/></w:pPr></w:pPrDefault></w:docDefaults><w:style w:type="paragraph" w:default="1" w:styleId="Normal"><w:name w:val="Normal"/><w:qFormat/></w:style></w:styles>',
      "word/header1.xml": head + '<w:hdr ' + NS + '><w:p><w:pPr><w:jc w:val="center"/></w:pPr>' + runXml({ t: name, b: false, i: false }) + "</w:p></w:hdr>",
      "word/footer1.xml": head + '<w:ftr ' + NS + '><w:p><w:pPr><w:jc w:val="center"/></w:pPr>' + runXml({ t: "Page ", b: false, i: false }) + fieldXml("PAGE") + runXml({ t: " of ", b: false, i: false }) + fieldXml("NUMPAGES") + "</w:p></w:ftr>",
      "word/document.xml": head + "<w:document " + NS + "><w:body>" + body + "</w:body></w:document>"
    };
    var zip = new window.JSZip();
    Object.keys(files).forEach(function (k) { zip.file(k, files[k], { createFolders: false }); });
    return zip.generateAsync({ type: "uint8array", compression: "DEFLATE" });
  }
  var downloadsCap = null;
  if (window.claude && window.claude.use) {
    window.claude.use("downloads").then(function (d) { downloadsCap = d; $("xDocx").hidden = !d; $("xLog").hidden = !d; $("xCsv").hidden = !d; $("xLang").hidden = !d; $("xNoSave").hidden = !!d; }, function () { /* no saving here */ });
  }


  /* ---------- languages: which words are Swahili, English, a name, or a mix (this is the data the model learns from) ---------- */
  function vocabulary() {
    var seen = {};
    S.chunks.forEach(function (c, i) {
      parseLines(stripMarks(textOf(i))).forEach(function (l) {
        tokenize(l.text).forEach(function (it) {
          if (!it.segs.length) return;
          var word = it.segs.map(function (sg) { return sg[0]; }).join(""), low = word.toLowerCase();
          if (!/\p{L}/u.test(word)) return;
          var anySw = it.segs.some(function (sg) { return sg[1] === "sw"; }), allSw = it.segs.every(function (sg) { return sg[1] === "sw"; });
          var cls = it.segs.length > 1 && anySw && !allSw ? "mixed" : allSw ? "sw" : "other";
          var r = seen[low] || (seen[low] = { word: word, low: low, n: 0, chunk: i + 1, cls: cls, parts: it.segs, name: it.segs[0][1] === "name" });
          r.n += 1;
        });
      });
    });
    var out = { mixed: [], unsure: [], sw: [] };
    Object.keys(seen).forEach(function (k) {
      var r = seen[k];
      if (r.cls === "mixed") out.mixed.push(r);
      else if (r.cls === "sw") out.sw.push(r);
      else if (!r.name && !EN.has(r.low) && !LEX.words[r.low] && r.low.length > 2) out.unsure.push(r);
    });
    return out;
  }
  function markerOf(parts) { return parts.map(function (sg) { return sg[1] === "sw" ? "_" + sg[0] + "_" : sg[0]; }).join(""); }
  function parseSplit(str, low) {              // "_ana_feel" -> [["ana","sw"],["feel","en"]]; the parts must spell the word
    var re = new RegExp(MARK_SRC, "gu"), out = [], last = 0, m;
    while ((m = re.exec(str))) {
      if (m.index > last) out.push([str.slice(last, m.index).toLowerCase(), "en"]);
      out.push([(m[1] !== undefined ? m[1] : m[2] !== undefined ? m[2] : m[3]).toLowerCase(), m[2] !== undefined ? "sw" : "en"]);
      last = m.index + m[0].length;
    }
    if (last < str.length) out.push([str.slice(last).toLowerCase(), "en"]);
    return out.join("") && out.map(function (p) { return p[0]; }).join("") === low ? out : null;
  }
  function afterLexChange() { saveLex(); scheduleProse(); showPreview(); renderLang(); }
  function langRow(r, kind) {
    var row = document.createElement("div"); row.className = "lrow";
    var w = document.createElement("span"); w.className = "lw"; w.innerHTML = kind === "mixed" ? bodyHTML(markerOf(r.parts)) : esc(r.word);
    var n = document.createElement("span"); n.className = "ln muted"; n.textContent = "×" + r.n + " · chunk " + r.chunk;
    row.appendChild(w); row.appendChild(n);
    function btn(label, fn) { var b = document.createElement("button"); b.className = "btn small"; b.textContent = label; b.onclick = fn; row.appendChild(b); return b; }
    if (kind === "mixed") {
      var inp = document.createElement("input"); inp.className = "field lsplit"; inp.value = markerOf(r.parts); inp.setAttribute("aria-label", "Parts of " + r.word); row.appendChild(inp);
      btn("Apply", function () {
        var parts = parseSplit(inp.value.trim(), r.low);
        if (!parts) { toast("The parts must spell the same word. Put _ _ around the Swahili part."); return; }
        LEX.splits[r.low] = parts; delete LEX.words[r.low]; afterLexChange();
      });
    }
    [["sw", "Swahili"], ["en", "English"], ["name", "Name"]].forEach(function (pair) {
      btn(pair[1], function () { LEX.words[r.low] = pair[0]; delete LEX.splits[r.low]; afterLexChange(); });
    });
    return row;
  }
  function renderLang() {
    var q = $("lSearch").value.trim().toLowerCase(), v = vocabulary(), body = $("lBody"); body.innerHTML = "";
    [["Combined words: Swahili and English in one word", "mixed"], ["Not sure what these are", "unsure"], ["Swahili words the page found", "sw"]].forEach(function (g) {
      var list = v[g[1]].filter(function (r) { return !q || r.low.indexOf(q) >= 0; }).sort(function (a, b) { return b.n - a.n; });
      var h = document.createElement("h3"); h.textContent = g[0] + " (" + list.length + ")"; body.appendChild(h);
      if (!list.length) { var e = document.createElement("p"); e.className = "muted"; e.textContent = "None."; body.appendChild(e); }
      list.slice(0, 120).forEach(function (r) { body.appendChild(langRow(r, g[1])); });
      if (list.length > 120) { var m = document.createElement("p"); m.className = "muted"; m.textContent = "Showing the 120 most frequent. Search to find others."; body.appendChild(m); }
    });
    $("lCount").textContent = Object.keys(LEX.words).length + " words and " + Object.keys(LEX.splits).length + " splits in your list";
  }
  $("lSearch").addEventListener("input", renderLang);
  $("lReset").onclick = function () {
    var b = $("lReset");
    if (!b.dataset.armed) { b.dataset.armed = "1"; b.textContent = "Tap again to clear my list"; return; }
    b.dataset.armed = ""; b.textContent = "Clear my list"; LEX.words = {}; LEX.splits = {}; afterLexChange();
  };
  function labelRows() {                       // one row per word of the final text, with its language
    stash();
    var rows = [];
    S.chunks.forEach(function (c, i) {
      parseLines(textOf(i)).forEach(function (l) {
        l.text.split(/\s+/).filter(Boolean).forEach(function (tok) {
          var parts = [], re = new RegExp(MARK_SRC, "gu"), last = 0, m, marked = false;
          function auto(t) { if (t) tokenize(t).forEach(function (it) { it.segs.forEach(function (sg) { parts.push({ t: sg[0], lang: sg[1], src: "auto" }); }); }); }
          while ((m = re.exec(tok))) {
            auto(tok.slice(last, m.index));
            if (m[1] !== undefined) auto(m[1]);
            else if (m[2] !== undefined) { parts.push({ t: m[2], lang: "sw", src: "mark" }); marked = true; }
            else { parts.push({ t: m[3], lang: "en", src: "mark" }); marked = true; }
            last = m.index + m[0].length;
          }
          auto(tok.slice(last));
          parts = parts.filter(function (p) { return /[\p{L}\p{N}]/u.test(p.t); });
          if (!parts.length) return;
          var langs = []; parts.forEach(function (p) { if (langs.indexOf(p.lang) < 0) langs.push(p.lang); });
          var word = parts.map(function (p) { return p.t; }).join(""), low = word.toLowerCase();
          rows.push({ chunk: i + 1, start: c.start, end: c.end, speaker: l.label.charAt(0), token: word, language: langs.length > 1 ? "mixed" : langs[0],
            parts: langs.length > 1 ? parts.map(function (p) { return p.t + ":" + p.lang; }).join("|") : "",
            source: marked ? "your mark" : (LEX.words[low] || LEX.splits[low]) ? "your list" : "automatic" });
        });
      });
    });
    return rows;
  }

  /* ---------- the corrections log: what Scribe wrote, what the cleaning did, what you changed (for the main project) ---------- */
  function wordsOf2(t) { return stripMarks(t).replace(/^[ \t]*[IR]\d*:[ \t]*/gm, "").split(/\s+/).filter(Boolean); }
  function normTok(w) { return w.toLowerCase().replace(/^[^\p{L}\p{N}]+|[^\p{L}\p{N}]+$/gu, ""); }
  function diffWords(a, b) {                 // pairs of (words before, words after) where the two texts differ
    var n = a.length, m = b.length, dp = [], i, j, pairs = [];
    for (i = 0; i <= n; i++) { dp.push(new Array(m + 1).fill(0)); }
    for (i = n - 1; i >= 0; i--) for (j = m - 1; j >= 0; j--) dp[i][j] = normTok(a[i]) === normTok(b[j]) ? dp[i + 1][j + 1] + 1 : Math.max(dp[i + 1][j], dp[i][j + 1]);
    i = 0; j = 0;
    var del = [], ins = [];
    function flush() { if (del.length || ins.length) { pairs.push([del.join(" "), ins.join(" ")]); del = []; ins = []; } }
    while (i < n || j < m) {
      if (i < n && j < m && normTok(a[i]) === normTok(b[j])) { flush(); i++; j++; }
      else if (j < m && (i === n || dp[i][j + 1] >= dp[i + 1][j])) { ins.push(b[j]); j++; }
      else { del.push(a[i]); i++; }
    }
    flush();
    return pairs.filter(function (p) { return normTok(p[0]) !== normTok(p[1]); });
  }
  function buildLog() {
    stash();
    var chunks = [], changes = {}, added = {}, removed = {}, mixed = {}, nChanged = 0, nChecked = 0;
    S.chunks.forEach(function (c, i) {
      var cleaned = origText(i), fin = textOf(i), changed = fin !== cleaned;
      if (S.done[i]) nChecked += 1;
      chunks.push({ chunk: i + 1, start: c.start, end: c.end, checked: !!S.done[i], changed: changed,
        scribe_raw: c.rawRuns.map(function (r) { return { speaker: r.speaker, text: r.text }; }), after_automatic_clean_up: cleaned, final: fin });
      var re = new RegExp(MARK_SRC, "gu"), m;
      while ((m = re.exec(fin))) {             // the marks you put on are language labels for the mixed words
        if (m[2] !== undefined && tokenize(m[2]).every(function (it) { return !it.segs.some(function (sg) { return sg[1] === "sw"; }); })) added[m[2]] = (added[m[2]] || 0) + 1;
        if (m[3] !== undefined && tokenize(m[3]).some(function (it) { return it.segs.some(function (sg) { return sg[1] === "sw"; }); })) removed[m[3]] = (removed[m[3]] || 0) + 1;
      }
      fin.split(/\s+/).forEach(function (w) {   // one word that is part Swahili and part English, written like _ni_break_ie_
        if (/[_~]/.test(w) && /\p{L}/u.test(w.replace(/[_~*]/g, ""))) {
          var parts = [], r2 = new RegExp(MARK_SRC, "gu"), last = 0, mm;
          while ((mm = r2.exec(w))) {
            if (mm.index > last) parts.push({ text: w.slice(last, mm.index), language: "auto" });
            parts.push({ text: mm[1] || mm[2] || mm[3], language: mm[2] !== undefined ? "sw" : mm[3] !== undefined ? "en" : "bold" });
            last = mm.index + mm[0].length;
          }
          if (last < w.length) parts.push({ text: w.slice(last), language: "auto" });
          if (parts.length > 1 && parts.some(function (p) { return p.language === "sw"; }) && parts.some(function (p) { return p.language === "en" || p.language === "auto"; })) mixed[w] = parts;
        }
      });
      if (changed) {
        nChanged += 1;
        diffWords(wordsOf2(cleaned), wordsOf2(fin)).forEach(function (p) {
          var key = p[0] + "\u0001" + p[1]; (changes[key] = changes[key] || { from: p[0], to: p[1], count: 0, chunks: [] }).count += 1; changes[key].chunks.push(i + 1);
        });
      }
    });
    var list = Object.keys(changes).map(function (k) { return changes[k]; }).sort(function (a, b) { return b.count - a.count; });
    return {
      format: "kenyan-transcript-corrections/1", file: $("xName").value.trim() || "Transcript", recording: S.rec ? { id: S.rec.id, name: S.rec.name } : null, saved_at: new Date().toISOString(),
      language_labels: (function () { var t = { sw: 0, en: 0, name: 0, mixed: 0 }; labelRows().forEach(function (r) { t[r.language] = (t[r.language] || 0) + 1; }); return t; })(),
      source: "ElevenLabs Scribe, " + (S.chunks.length ? "transcription id " + (S.key.split(":")[1] || "") : ""),
      note: "scribe_raw is the first transcript. after_automatic_clean_up is what this page showed. final is what a person corrected it to. Marks in final: **bold**, _italic_ = Swahili, ~plain~ = not Swahili.",
      totals: { chunks: S.chunks.length, checked: nChecked, changed_by_person: nChanged, distinct_word_changes: list.length,
        swahili_added_by_person: Object.keys(added).length, swahili_removed_by_person: Object.keys(removed).length, mixed_words: Object.keys(mixed).length },
      word_changes: list, swahili_added_by_person: added, swahili_removed_by_person: removed,
      mixed_words: Object.keys(mixed).map(function (w) { return { written: w, parts: mixed[w] }; }), chunks: chunks
    };
  }
  function csvCell(v) { v = String(v); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; }
  function saveFile(fileName, data, okMsg) {
    if (!downloadsCap) { $("outMsg").textContent = "Saving a file is not available in this view."; return; }
    downloadsCap.save({ filename: fileName, data: data }).then(function () { $("outMsg").textContent = okMsg; },
      function (err) { $("outMsg").textContent = err && err.code === "declined" ? "Not saved." : "Could not save the file here" + (err && err.message ? ": " + err.message : "."); });
  }
  $("xLog").addEventListener("click", function () {
    var log = buildLog(), name = ($("xName").value.trim() || "Transcript").replace(/[\\/:*?"<>|]+/g, "-");
    saveFile(name + " corrections log.json", JSON.stringify(log, null, 1), "Saved the corrections log: " + log.totals.changed_by_person + " chunks changed by a person, " + log.totals.distinct_word_changes + " different word changes.");
  });
  $("xLang").addEventListener("click", function () {
    var rows = labelRows(), name = ($("xName").value.trim() || "Transcript").replace(/[\\/:*?"<>|]+/g, "-"), rec = (S.rec ? S.rec.name : name).replace(/"/g, "");
    var out = ["recording,chunk,start,end,speaker,token,language,parts,source"].concat(rows.map(function (r) {
      return [csvCell(rec), r.chunk, r.start.toFixed(2), r.end.toFixed(2), r.speaker, csvCell(r.token), r.language, csvCell(r.parts), r.source].join(",");
    }));
    var t = { sw: 0, en: 0, name: 0, mixed: 0 }; rows.forEach(function (r) { t[r.language] = (t[r.language] || 0) + 1; });
    saveFile(name + " language labels.csv", out.join("\n") + "\n", "Saved " + rows.length + " labelled words: " + t.sw + " Swahili, " + t.en + " English, " + t.mixed + " combined, " + t.name + " names.");
  });
  $("xCsv").addEventListener("click", function () {
    var log = buildLog(), name = ($("xName").value.trim() || "Transcript").replace(/[\\/:*?"<>|]+/g, "-");
    var rows = ["from,to,count,chunks"].concat(log.word_changes.map(function (c) { return [csvCell(c.from), csvCell(c.to), c.count, csvCell(c.chunks.slice(0, 20).join(" "))].join(","); }));
    saveFile(name + " word changes.csv", rows.join("\n") + "\n", "Saved the word changes: " + log.word_changes.length + " rows.");
  });

  $("xDocx").addEventListener("click", function () {
    var name = $("xName").value.trim() || "Transcript";
    if (!window.JSZip) { $("outMsg").textContent = "The Word file tool did not load. Check the internet connection and reload."; return; }
    stash();
    buildDocx(name, withTime()).then(function (data) {
      var fileName = name.replace(/[\\/:*?"<>|]+/g, "-") + (withTime() ? " (with timestamps)" : "") + ".docx";
      return downloadsCap.save({ filename: fileName, data: data });
    }).then(function () { $("outMsg").textContent = "Saved. Open it in Word or Google Docs: the page numbers and header come with it."; },
      function (err) { $("outMsg").textContent = err && err.code === "declined" ? "Not saved." : "Could not save the file here" + (err && err.message ? ": " + err.message : "."); });
  });

  function copyRich() {
    showRich();
    var html = richHTML(), plain = plainText();
    var done = function () { $("outMsg").textContent = "Copied with bold and italics. Paste it into Word or Google Docs."; };
    var legacy = function () {
      var el = $("richOut"), r = document.createRange(); r.selectNodeContents(el);
      var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(r);
      var ok = false; try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
      if (ok) done(); else $("outMsg").textContent = "Text selected above. Long-press it and choose Copy.";
    };
    try {
      if (window.ClipboardItem && navigator.clipboard && navigator.clipboard.write) {
        navigator.clipboard.write([new ClipboardItem({ "text/html": new Blob([html], { type: "text/html" }), "text/plain": new Blob([plain], { type: "text/plain" }) })]).then(done, legacy);
        return;
      }
    } catch (e) { /* fall through */ }
    legacy();
  }
  $("xRich").addEventListener("click", copyRich);
  document.querySelectorAll("[data-fmt]").forEach(function (b) {
    b.addEventListener("click", function () {
      $("richOut").hidden = true; $("out").hidden = false; $("out").value = render(b.dataset.fmt);
      var done = function () { $("outMsg").textContent = "Copied. Paste it into a notes app or a document."; };
      var fallback = function () { $("out").focus(); $("out").select(); $("outMsg").textContent = "Text selected below. Long-press it and choose Copy."; };
      try { navigator.clipboard.writeText($("out").value).then(done, fallback); } catch (e) { fallback(); }
    });
  });
})();
